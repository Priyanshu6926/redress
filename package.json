{
  "name": "redress",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cre/sentinel-verdict",
    "vectors": "python contracts/test/gen_vectors.py",
    "vectors:random": "bun cre/sentinel-verdict/gen-random-vectors.ts",
    "vectors:reports": "bun replay/gen-report-fixture.ts",
    "offchain": "bun replay/fetch-offchain.ts",
    "verify": "bun replay/verify-onchain.mjs",
    "fetch-incident": "bun replay/fetch-incident.ts",
    "replay:fetch": "bun replay/fetch-reads.ts",
    "replay": "bun replay/replay.ts",
    "scorecard": "bun replay/scorecard.ts",
    "cre:config": "bun replay/gen-cre-config.ts",
    "snapshot:serve": "bun replay/serve-snapshot.ts",
    "fork:up": "bash replay/fork-up.sh",
    "fork:deploy": "bash replay/fork-deploy.sh",
    "sepolia:deploy": "bash replay/deploy-sepolia.sh",
    "replay:fork": "bun replay/mirror.ts fork",
    "mirror": "bun replay/mirror.ts sepolia"
  },
  "dependencies": {
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  }
}