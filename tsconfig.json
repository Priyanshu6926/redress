{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["bun-types"]
  },
  "include": ["cre/sentinel-verdict/verdict*.ts", "cre/sentinel-verdict/position.ts", "cre/sentinel-verdict/bonus.ts", "cre/sentinel-verdict/report*.ts", "cre/sentinel-verdict/gen-random-vectors.ts", "replay/**/*.ts", "backend/**/*.ts"],
  "exclude": ["**/node_modules", "web", "contracts"]
}
