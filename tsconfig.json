{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["bun-types"]
  },
  "include": ["cre/**/*.ts", "replay/**/*.ts", "backend/**/*.ts"],
  "exclude": ["node_modules", "web", "contracts"]
}
