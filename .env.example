# Copy to .env and fill in. .env is gitignored: never commit real values.

# Etherscan API V2 key
ETHERSCAN_API_KEY=

# Mainnet archive RPC URL. Must serve historical state for March 2026.
MAINNET_RPC=

# Sepolia RPC URL, for the public mirror.
SEPOLIA_RPC=

# Key that broadcasts simulated writes on Sepolia. Testnet only, funded with Sepolia ETH.
CRE_ETH_PRIVATE_KEY=

# Arkiv access key, from https://hub.arkiv.network/access-keys. The public endpoint runs out of
# its anonymous query budget, so reads need this.
ARKIV_ACCESS_KEY=
