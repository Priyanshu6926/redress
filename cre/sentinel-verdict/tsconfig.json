{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["bun-types"],
    "typeRoots": ["../../node_modules"]
  },
  "include": ["main.ts", "handler.ts", "handler.test.ts"]
}
